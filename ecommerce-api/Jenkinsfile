pipeline {

    agent any

    stages {

        stage('Initialize'){
            steps{
                echo '========================='
                echo 'starting the E commerce CI pipeline'
                echo '========================='
            }
        }

        stage('Checkout'){
            steps {
                echo 'Source code is ready '
            }
        }

        stage('Build'){
            steps{
                echo 'Compiling spring boot app'

                 dir('ecommerce-api') {
                            sh 'chmod +x mvnw'
                            sh './mvnw clean compile'
                        }

            }
        }

        stage('Test'){
            steps{
                echo 'Exeucting the tests'
                dir('ecommerce-api'){
                    sh './mvnw test'
                   }
            }
        }

        stage('Package'){
            steps{
                echo 'Packaging application'
                dir('ecommerce-api'){
                    //Generate the executable JAR in target/
                    sh './mvnw package -DskipTests'

                    //Create a seperate deployment directory
                    sh 'mkdir -p deployment'

                    //Copy the generated executable jar
                    sh 'cp target/*.jar deployment'


                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('ecommerce-api') {
                    sh '''
                        docker build \
                            -t ecommerce-api:${BUILD_NUMBER} \
                            -t ecommerce-api:latest \
                            .
                    '''
                }
            }
        }

    }

    post{
        success{
          echo 'E-Commerce CI Pipeline completed successfully!'
        }

        failure{
         echo 'E-Commerce CI Pipeline failed!'
        }

        always{
        echo 'Pipeline execution finished.'
        }

    }
}